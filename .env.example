# Upstash Redis REST credentials for the shared guest roster and draw.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel's Upstash integration can also supply KV_REST_API_URL and KV_REST_API_TOKEN.
# The app accepts a single complete connection with a custom Vercel prefix.

# Set to true when guests can draw names.
SANTA_SHUFFLE_DRAW_OPEN=false
